---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "Actualmente...",
    title: "Desarrollador mid-senior",
    company: "Coordinadora Mercantil S.A.S",
    description: "Me dedico a desarrollar aplicaciones móviles en el sistema Android, utilizando la tecnología Kotlin y Jetpack Compose. Además, me encargo de la creación y la implementación de microservicios con Nodejs y Express, usando herramientas como Azure DevOps y Google Cloud.",
  },
  {
    date: "feb. 2021 - oct. 2022",
    title: "Desarrollador junior",
    company: "Coordinadora Mercantil S.A.S",
    description: "Durante esta etapa me desempeñé en las áreas de desarrollo Android y Backend. Para el desarrollo móvil utilicé la tecnología Kotlin y para el Backend, Nodejs, Express, Nextjs, TypeScript, Google Cloud y Firebase.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
